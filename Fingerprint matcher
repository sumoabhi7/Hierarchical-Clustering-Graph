import cv2
import numpy as np
from skimage.morphology import skeletonize
import sys

def process_fingerprint_image(image_path):
    """
    Processes a single fingerprint image to find minutiae.
    """
    # Step 1: Load the image in grayscale
    try:
        img = cv2.imread(image_path, 0)
        if img is None:
            print(f"Error: Could not load image at {image_path}")
            return None, None
    except Exception as e:
        print(f"Error reading image {image_path}: {e}")
        return None, None

    # Step 2: Binarization using Adaptive Thresholding
    binary_image = cv2.adaptiveThreshold(
        img, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
        cv2.THRESH_BINARY_INV, 11, 2
    )

    # Ensure strictly 0 and 1
    binary_image = (binary_image > 0).astype(np.uint8)

    # Step 3: Thinning (Skeletonization)
    skeleton = skeletonize(binary_image)
    thinned_image = (skeleton.astype(np.uint8) * 255)

    # Debug: check if skeletonization worked
    print(f"[DEBUG] Nonzero pixels in skeleton ({image_path}): {np.count_nonzero(thinned_image)}")

    # Step 4: Minutiae Extraction
    minutiae = extract_minutiae(thinned_image)
    
    return minutiae, thinned_image


def extract_minutiae(thinned_image):
    """
    Finds minutiae points (ridge endings and bifurcations) from a thinned fingerprint image.
    Uses the Crossing Number (CN) method.
    """
    minutiae_points = []
    thinned_image = cv2.copyMakeBorder(thinned_image, 1, 1, 1, 1, cv2.BORDER_CONSTANT)
    rows, cols = thinned_image.shape
    
    for i in range(1, rows - 1):
        for j in range(1, cols - 1):
            if thinned_image[i, j] == 255:  # ridge pixel
                # 8 neighbors
                p = [thinned_image[i-1, j-1], thinned_image[i-1, j], thinned_image[i-1, j+1],
                     thinned_image[i,   j+1], thinned_image[i+1, j+1], thinned_image[i+1, j],
                     thinned_image[i+1, j-1], thinned_image[i,   j-1]]

                # Normalize explicitly to 0 or 1
                p = [1 if x > 0 else 0 for x in p]

                # Crossing Number (CN) with wraparound
                cn = 0.5 * sum(abs(p[k] - p[(k+1) % 8]) for k in range(8))

                if cn == 1:
                    minutiae_points.append(((j-1, i-1), "ending"))
                elif cn == 3:
                    minutiae_points.append(((j-1, i-1), "bifurcation"))

    return minutiae_points


def compare_minutiae(minutiae1, minutiae2, distance_threshold=25):
    """
    Compare two sets of minutiae points with centroid alignment.
    """
    if len(minutiae1) == 0 or len(minutiae2) == 0:
        return 0.0

    # --- Align by centroid ---
    def get_centroid(minutiae):
        xs = [p[0][0] for p in minutiae]
        ys = [p[0][1] for p in minutiae]
        return (np.mean(xs), np.mean(ys))

    c1 = get_centroid(minutiae1)
    c2 = get_centroid(minutiae2)

    # Shift minutiae2 so its centroid aligns with minutiae1
    shifted_minutiae2 = [((int(p[0][0] + (c1[0]-c2[0])),
                           int(p[0][1] + (c1[1]-c2[1]))), p[1])
                         for p in minutiae2]

    # --- Match minutiae ---
    matched_pairs = 0
    temp_minutiae2 = list(shifted_minutiae2)

    for m1_point, m1_type in minutiae1:
        best_match_index = -1
        min_dist = float('inf')

        for i, (m2_point, m2_type) in enumerate(temp_minutiae2):
            if m1_type == m2_type:
                dist = np.sqrt((m1_point[0] - m2_point[0])**2 + (m1_point[1] - m2_point[1])**2)
                
                if dist < distance_threshold and dist < min_dist:
                    min_dist = dist
                    best_match_index = i
        
        if best_match_index != -1:
            matched_pairs += 1
            del temp_minutiae2[best_match_index]

    score = (matched_pairs / max(len(minutiae1), len(minutiae2))) * 100
    return score


# --- Main Execution ---
if __name__ == "__main__":
    if len(sys.argv) != 3:
        print("Usage: python fingerprint_matcher.py <path_to_image1> <path_to_image2>")
        sys.exit(1)

    image1_path = sys.argv[1]
    image2_path = sys.argv[2]
    
    print("Processing Image 1...")
    minutiae1, thinned1 = process_fingerprint_image(image1_path)
    
    print("Processing Image 2...")
    minutiae2, thinned2 = process_fingerprint_image(image2_path)
    
    if minutiae1 is not None and minutiae2 is not None:
        print(f"\nFound {len(minutiae1)} minutiae points in Image 1.")
        print(f"Found {len(minutiae2)} minutiae points in Image 2.")
        
        similarity_score = compare_minutiae(minutiae1, minutiae2)
        print(f"\n--- SIMILARITY SCORE: {similarity_score:.2f}% ---")
        
        # Visualization
        img1_color = cv2.cvtColor(thinned1, cv2.COLOR_GRAY2BGR)
        img2_color = cv2.cvtColor(thinned2, cv2.COLOR_GRAY2BGR)

        for point, m_type in minutiae1:
            color = (0, 255, 0) if m_type == "ending" else (0, 0, 255)
            cv2.circle(img1_color, point, 3, color, -1)
            
        for point, m_type in minutiae2:
            color = (0, 255, 0) if m_type == "ending" else (0, 0, 255)
            cv2.circle(img2_color, point, 3, color, -1)

        cv2.imshow('Image 1 Minutiae (Green=Ending, Red=Bifurcation)', img1_color)
        cv2.imshow('Image 2 Minutiae (Green=Ending, Red=Bifurcation)', img2_color)
        cv2.waitKey(0)
        cv2.destroyAllWindows()

